# The real ProsERP backend (same value as API_BASE_URL in live-repo), NOT the Next.js host.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time — never put secrets here.
# Android emulator: use 10.0.2.2 instead of localhost. Physical device: use your machine's LAN IP.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api

